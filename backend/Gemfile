# frozen_string_literal: true

source 'https://rubygems.org'

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem 'rails', '~> 8.1.3'
# Use postgresql as the database for Active Record
gem 'pg', '~> 1.1'
# Use the Puma web server [https://github.com/puma/puma]
gem 'puma', '>= 5.0'

# CORS configuration
gem 'rack-cors'

# Rate limiting
gem 'rack-attack'

# GraphQL configuration
gem 'graphql', '~> 2.4'

# Redis & Sidekiq background jobs
gem 'redis', '~> 5.0'
gem 'sidekiq', '~> 7.0'
gem 'sidekiq-cron', '~> 1.12'

# JWT Authentication
gem 'jwt', '~> 2.9'

# Shop owner authentication (password hashing via Devise; API sessions via JWT)
gem 'devise', '~> 5.0'

# HTTP client for external integrations (payOS, etc.)
gem 'faraday', '~> 2.12'

# Excel Report Export & Import
gem 'caxlsx', '~> 4.0'
gem 'roo', '~> 2.10'

# Soft delete (discarding records instead of physical deletion)
gem 'discard', '~> 1.3'

group :development, :test do
  gem 'debug', platforms: %i[mri windows], require: 'debug/prelude'
  gem 'dotenv-rails'
  gem 'rspec-rails', '~> 7.0'
  gem 'webmock'
end

group :development do
  gem 'rubocop', '~> 1.63', require: false
  gem 'rubocop-rails', require: false
  gem 'rubocop-rspec', require: false
end
